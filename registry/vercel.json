{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": false,
  "headers": [
    { "source": "/r/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, s-maxage=60" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ]
}
