{
  "name": "@kybernesis/manage",
  "version": "0.8.0",
  "description": "Let KYBER Studio install capabilities and write schedules onto a running eve agent.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
