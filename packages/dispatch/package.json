{
  "name": "@kybernesis/dispatch",
  "version": "0.1.0",
  "description": "Agent-to-agent dispatch for eve agents: declared remote-peer edges with principal forwarding on by default, and a receiver channel that makes trusting the wrong caller hard to express.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://kybernesis.ai",
  "keywords": [
    "eve",
    "kybernesis",
    "agent-to-agent",
    "remote-agent",
    "dispatch",
    "a2a"
  ],
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "eve": "0.30.8",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "eve": ">=0.30.0 <0.31.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KybernesisAI/platform.git",
    "directory": "packages/dispatch"
  },
  "publishConfig": {
    "access": "public"
  }
}
