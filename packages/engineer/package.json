{
  "name": "@kybernesis/engineer",
  "version": "0.6.2",
  "description": "Engineer capabilities for eve agents: a vision-verified dev loop (in-sandbox screenshots the model can see), trade-school skills for building and shipping software, and disciplined git/deploy behavior.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://kybernesis.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KybernesisAI/platform.git",
    "directory": "packages/engineer"
  },
  "keywords": [
    "eve",
    "kybernesis",
    "engineer",
    "agent",
    "screenshot",
    "vision",
    "dev"
  ],
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    },
    "./git": {
      "types": "./dist/git.d.ts",
      "default": "./dist/git.js"
    }
  },
  "scripts": {
    "build": "eve extension build && tsc -p tsconfig.build.json",
    "prepack": "eve extension build && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepublishOnly": "node ../../scripts/prepublish.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@vercel/blob": "^2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "eve": "^0.51.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "eve": ">=0.51.0 <0.52.0"
  },
  "engines": {
    "node": ">=20"
  }
}
