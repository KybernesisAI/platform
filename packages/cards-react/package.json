{
  "name": "@kybernesis/cards-react",
  "version": "0.2.0",
  "description": "React components that draw Kybernesis cards: one frame and one body per card type, themed by CSS variables, with the host's own way to open links, artifacts and files.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KybernesisAI/platform.git",
    "directory": "packages/cards-react"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/prepublish.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "peerDependencies": {
    "@kybernesis/cards": "^0.5.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@kybernesis/cards": "^0.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
