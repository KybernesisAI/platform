{
  "name": "@kybernesis/buzz",
  "version": "0.8.0",
  "description": "Put an eve agent in a Buzz workspace as a member: per-speaker verified identity resolved through the control plane, self-service identity linking, presence, typing and seen signals.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://kybernesis.ai",
  "keywords": [
    "eve",
    "kybernesis",
    "buzz",
    "nostr",
    "agent",
    "channel",
    "multiplayer"
  ],
  "files": [
    "dist",
    "NOTICE"
  ],
  "bin": {
    "kybernesis-buzz": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    },
    "./extension": {
      "types": "./dist/extension/extension.d.ts",
      "default": "./dist/extension/extension.mjs"
    }
  },
  "scripts": {
    "build": "eve extension build && tsc -p tsconfig.build.json",
    "prepack": "eve extension build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/prepublish.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@kybernesis/enterprise": "^0.7.0",
    "nostr-tools": "^2.10.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "eve": "0.38.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "eve": ">=0.38.0 <0.39.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KybernesisAI/platform.git",
    "directory": "packages/buzz"
  },
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  }
}
