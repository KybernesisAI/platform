{
  "name": "@kybernesis/local",
  "version": "0.8.2",
  "description": "Let a deployed eve agent work on the user's own machine, through KYBER Studio.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "node ../../scripts/prepublish.mjs"
  },
  "peerDependencies": {
    "eve": ">=0.51.0 <0.52.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eve": "^0.51.1",
    "typescript": "^5.7.2"
  }
}
