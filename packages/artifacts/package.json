{
  "name": "@kybernesis/artifacts",
  "version": "0.2.0",
  "description": "Artifacts for eve agents: pages an agent makes for a person (reports, dashboards, trackers) that KYBER Studio and the phone draw inline, stored on the agent's own machine.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://kybernesis.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KybernesisAI/platform.git",
    "directory": "packages/artifacts"
  },
  "keywords": [
    "eve",
    "kybernesis",
    "artifacts",
    "agent"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./store": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension/extension.d.ts",
      "default": "./dist/extension/extension.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "eve extension build && tsc -p tsconfig.build.json",
    "prepack": "eve extension build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/prepublish.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "eve": ">=0.81.1 <0.82.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "eve": "0.81.1",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  }
}
