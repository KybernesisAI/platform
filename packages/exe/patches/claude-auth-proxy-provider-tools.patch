+/// Provider-executed tools use a versioned `type`; ordinary client tools omit
+/// it (or explicitly use `custom`). Provider tool names are protocol fields,
+/// not user-controlled identifiers, and must never be rewritten.
+fn is_provider_tool(tool: &crate::bodies::Tool) -> bool {
+    tool.extra
+        .get("type")
+        .and_then(serde_json::Value::as_str)
+        .is_some_and(|tool_type| tool_type != "custom")
+}
