{
  "name": "@kybernesis/exe",
  "version": "0.9.1",
  "description": "Run eve agents on exe.dev VMs: subscription-backed model access through the LLM integration, process supervision, and an optional Slack binding. Channel-agnostic core.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://kybernesis.ai",
  "keywords": [
    "eve",
    "kybernesis",
    "exe.dev",
    "self-hosting",
    "agent",
    "llm"
  ],
  "files": [
    "dist",
    "scripts",
    "NOTICE",
    "patches"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./slack": {
      "types": "./dist/slack.d.ts",
      "default": "./dist/slack.js"
    },
    "./package.json": "./package.json",
    "./photon": {
      "types": "./dist/photon.d.ts",
      "default": "./dist/photon.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "default": "./dist/sandbox.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/prepublish.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "24.x",
    "eve": "0.38.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "eve": ">=0.38.0 <0.39.0",
    "zod": "^4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KybernesisAI/platform.git",
    "directory": "packages/exe"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
