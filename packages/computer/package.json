{
  "name": "@kybernesis/computer",
  "version": "0.5.1",
  "description": "A persistent, isolated computer for an eve agent — a Docker desktop with Chrome that a person can watch and take over — plus the rule for when an agent uses it instead of a connector, a tool, or the person's own machine.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KybernesisAI/platform.git",
    "directory": "packages/computer"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/prepublish.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@kybernesis/cards": "^0.2.0"
  },
  "peerDependencies": {
    "eve": ">=1.0.0-rc.10 <2.0.0",
    "zod": "^4"
  },
  "devDependencies": {
    "eve": "1.0.0-rc.10",
    "zod": "^4.0.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
