{
  "name": "@kybernesis/notify",
  "version": "0.1.0",
  "description": "Tell a person's phone when their agent needs them: a hook that reports parked prompts and finished turns to the Kybernesis control plane.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./extension": {
      "types": "./dist/extension/extension.d.ts",
      "default": "./dist/extension/extension.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "eve extension build && tsc -p tsconfig.build.json",
    "prepack": "eve extension build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/prepublish.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "peerDependencies": {
    "eve": ">=0.49.0 <0.50.0"
  },
  "devDependencies": {
    "eve": "0.49.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  }
}
