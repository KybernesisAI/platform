{
  "name": "@kybernesis/notify",
  "version": "0.4.0",
  "description": "Keep a person in the loop with their agent: a hook that rings their phone through the Kybernesis control plane when it parks on a question or finishes a reply, and a working_on_it tool that tells them it has started a long job.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./extension": {
      "types": "./dist/extension/extension.d.ts",
      "default": "./dist/extension/extension.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "eve extension build && tsc -p tsconfig.build.json",
    "prepack": "eve extension build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/prepublish.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "eve": ">=0.81.1 <0.82.0"
  },
  "devDependencies": {
    "@kybernesis/cards": "^0.7.0",
    "eve": "0.81.1",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  }
}
